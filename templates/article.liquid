<article class="section-py">
  <div class="container" style="max-width:720px;">
    <div class="eyebrow" style="margin-bottom:24px;">
      <a href="{{ blog.url }}" class="link-mute">{{ blog.title }}</a>
    </div>
    <h1 class="display h2" style="margin:0;">{{ article.title }}<span class="text-lime">.</span></h1>
    <div class="text-mute" style="font-size:13px;margin-top:24px;letter-spacing:.18em;text-transform:uppercase;">
      {{ article.published_at | date: '%b %d, %Y' }} {%- if article.author %} · {{ article.author }}{%- endif -%}
    </div>

    {%- if article.image -%}
      <div class="card-media" style="aspect-ratio:16/9;margin-top:48px;">
        <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.title | escape }}">
      </div>
    {%- endif -%}

    <div class="rte" style="margin-top:48px;font-size:16px;line-height:1.7;">
      {{ article.content }}
    </div>
  </div>
</article>

<style>
  .rte h2 { font-weight: 700; margin-top: 48px; margin-bottom: 16px; font-size: 24px; }
  .rte p { margin: 0 0 16px; }
  .rte img { margin: 24px 0; }
  .rte a { color: var(--bt-lime); text-decoration: underline; text-underline-offset: 3px; }
</style>
