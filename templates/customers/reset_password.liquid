<section class="section-py">
  <div class="container" style="max-width:480px;">
    <h1 class="display h3" style="margin:0;">Reset password<span class="text-lime">.</span></h1>
    {% form 'reset_customer_password' %}
      <div style="display:grid;gap:16px;margin-top:40px;">
        <input type="password" name="customer[password]" placeholder="New password" required autocomplete="new-password">
        <input type="password" name="customer[password_confirmation]" placeholder="Confirm new password" required autocomplete="new-password">
        {%- if form.errors -%}
          <div class="text-orange" style="font-size:13px;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <button type="submit" class="btn-lime btn-block">Reset password</button>
      </div>
    {% endform %}
  </div>
</section>
