<section class="section-py">
  <div class="container" style="max-width:480px;">
    <div class="eyebrow" style="margin-bottom:24px;">Account</div>
    <h1 class="display h3" style="margin:0;">Create account<span class="text-lime">.</span></h1>

    {% form 'create_customer' %}
      <div style="display:grid;gap:16px;margin-top:40px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <input type="text" name="customer[first_name]" placeholder="First name" autocomplete="given-name">
          <input type="text" name="customer[last_name]"  placeholder="Last name"  autocomplete="family-name">
        </div>
        <input type="email" name="customer[email]" placeholder="Email" required autocomplete="email">
        <input type="password" name="customer[password]" placeholder="Password" required autocomplete="new-password">
        {%- if form.errors -%}
          <div class="text-orange" style="font-size:13px;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <button type="submit" class="btn-lime btn-block" style="margin-top:8px;">Create account</button>
      </div>
    {% endform %}

    <div style="margin-top:24px;text-align:center;font-size:13px;color:var(--bt-text-mute);">
      Already have one? <a href="{{ routes.account_login_url }}" class="link-mute">Sign in</a>
    </div>
  </div>
</section>
