<section class="hero-canvas" style="min-height:100vh;display:flex;align-items:center;">
  <div class="container" style="text-align:center;">
    <img src="{{ 'logo-dark.svg' | asset_url }}" alt="{{ shop.name }}" style="height:60px;width:auto;margin:0 auto 64px;">

    <div class="eyebrow" style="margin-bottom:24px;">Coming Soon</div>
    <h1 class="display h-hero">Opening soon<span class="text-lime">.</span></h1>
    <p class="text-mute" style="margin-top:24px;font-size:18px;max-width:480px;margin-left:auto;margin-right:auto;">
      {{ shop.password_message | default: 'Trendy products. Budget prices. Real thrills. Drop one launches Friday.' }}
    </p>

    {% form 'storefront_password', class: 'pw-form' %}
      <div style="margin-top:48px;display:flex;gap:12px;max-width:400px;margin-left:auto;margin-right:auto;border-bottom:1px solid var(--bt-border);padding-bottom:12px;">
        <input type="password" name="password" placeholder="Store password" required style="flex:1;background:transparent;border:none;outline:none;padding:8px 0;font-size:16px;">
        <button type="submit" style="background:transparent;border:none;cursor:pointer;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;">Enter →</button>
      </div>
      {%- if form.errors -%}
        <div class="text-orange" style="margin-top:16px;font-size:13px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
    {% endform %}

    <div style="margin-top:64px;font-size:13px;color:var(--bt-text-mute);letter-spacing:.18em;text-transform:uppercase;">
      Notify me when we launch
    </div>
    {% form 'customer', class: 'nl-form' %}
      <input type="hidden" name="contact[tags]" value="prospect">
      <div style="margin-top:16px;display:flex;gap:12px;max-width:400px;margin-left:auto;margin-right:auto;border-bottom:1px solid var(--bt-border);padding-bottom:12px;">
        <input type="email" name="contact[email]" placeholder="you@get.thrilled" required style="flex:1;background:transparent;border:none;outline:none;padding:8px 0;font-size:16px;">
        <button type="submit" style="background:transparent;border:none;cursor:pointer;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;">Join →</button>
      </div>
      {%- if form.posted_successfully? -%}
        <div class="text-lime" style="margin-top:16px;font-size:13px;">You're on the list.</div>
      {%- endif -%}
    {% endform %}
  </div>
</section>
