<section class="section-py">
  <div class="container">
    <div class="eyebrow" style="margin-bottom:24px;">Search</div>
    <h1 class="display h2" style="margin:0;">
      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          Results for "{{ search.terms | escape }}"<span class="text-lime">.</span>
        {%- else -%}
          Nothing for "{{ search.terms | escape }}"<span class="text-lime">.</span>
        {%- endif -%}
      {%- else -%}
        Search<span class="text-lime">.</span>
      {%- endif -%}
    </h1>

    <form action="{{ routes.search_url }}" method="get" style="margin-top:48px;display:flex;gap:12px;border-bottom:1px solid var(--bt-border);padding-bottom:12px;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try: moon lamp, mouse pad, massage gun…"
             style="flex:1;background:transparent;border:none;outline:none;padding:8px 0;font-size:16px;">
      <button type="submit" style="background:transparent;border:none;cursor:pointer;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;">Search →</button>
    </form>

    {%- if search.performed and search.results_count > 0 -%}
      {% paginate search.results by 24 %}
        <div class="product-grid" style="margin-top:64px;" data-reveal>
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {%- elsif search.performed -%}
      <p class="text-mute" style="margin-top:32px;">Try a broader term, or <a href="{{ routes.root_url }}" class="link-mute">browse the homepage</a>.</p>
    {%- endif -%}
  </div>
</section>
