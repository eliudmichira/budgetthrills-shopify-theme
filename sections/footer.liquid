<footer class="hairline-t">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-col">
        {%- if settings.logo_dark != blank -%}
          <img src="{{ settings.logo_dark | image_url: width: 600 }}"
               alt="{{ shop.name }}"
               style="height:{{ settings.logo_height }}px;width:auto;margin-bottom:24px;"
               class="logo-darkmode">
        {%- else -%}
          <img src="{{ 'logo-dark.svg' | asset_url }}" alt="{{ shop.name }}" style="height:{{ settings.logo_height }}px;width:auto;margin-bottom:24px;">
        {%- endif -%}
        <p class="text-mute" style="font-size:14px;line-height:1.6;max-width:280px;margin:0 0 20px;">
          {{ shop.description | default: 'Trendy products. Budget prices. Real thrills.' }}
        </p>
        <div style="display:flex;gap:12px;">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 6.3a4.8 4.8 0 0 1-3.8-2H13v12a2.7 2.7 0 1 1-2.7-2.7v-3.4a6.1 6.1 0 1 0 6.1 6.1V9.2a8.1 8.1 0 0 0 4.5 1.4V7.5c-.4 0-.9-.4-1.3-1.2z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter != blank -%}
            <a href="{{ settings.social_twitter }}" aria-label="Twitter" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | escape }}</h4>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
      <div class="links">
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Refund Policy</a>{%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Brand", "menu": "footer" } }
    ]
  }
}
{% endschema %}
