<div class="container">
  <div class="announcement">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $50" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping over $50" } },
      { "type": "message", "settings": { "text": "New drop — every Friday, 8PM EST" } },
      { "type": "message", "settings": { "text": "BudgetThrills · 2026" } }
    ]
  }
}
{% endschema %}
