<section class="hairline-t section-py">
  <div class="container">
    <div class="ugc-header" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow" style="margin-bottom:16px;">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        <h2 class="display h2" style="margin:0;line-height:.9;">
          {{ section.settings.heading_line_1 | escape }}<br>{{ section.settings.heading_line_2 | escape }}<span class="text-lime">.</span>
        </h2>
      </div>
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="link-mute" style="font-size:13px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;align-self:flex-end;">{{ section.settings.link_text | escape }} →</a>
      {%- endif -%}
    </div>

    <div class="ugc-grid" data-reveal>
      {%- for block in section.blocks -%}
        <div class="ugc-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          {%- elsif block.settings.video_url != blank -%}
            <video src="{{ block.settings.video_url }}" autoplay loop muted playsinline></video>
          {%- else -%}
            <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--bt-text-mute);font-size:12px;">[ image ]</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .ugc-header { display:flex; justify-content:space-between; gap:24px; margin-bottom:56px; align-items:flex-end; }
</style>

{% schema %}
{
  "name": "UGC wall",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (9:16)" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Customer photo" },
        { "type": "url", "id": "video_url", "label": "Video URL (optional, overrides image)" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#BudgetThrills" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "In the" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "wild" },
    { "type": "text", "id": "link_text", "label": "Side link text", "default": "Tag us" },
    { "type": "url", "id": "link_url", "label": "Side link url" }
  ],
  "presets": [{
    "name": "UGC wall",
    "blocks": [
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" }
    ]
  }]
}
{% endschema %}
