[
  {
    "name": "theme_info",
    "theme_name": "BudgetThrills",
    "theme_version": "1.0.0",
    "theme_author": "BudgetThrills",
    "theme_documentation_url": "https://budgetthrills.com",
    "theme_support_email": "hello@budgetthrills.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Dark mode (default)"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Canvas",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_bg_soft",
        "label": "Soft canvas (cards / panels)",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_bg_elev",
        "label": "Elevated surface",
        "default": "#131313"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Hairline",
        "default": "#1C1C1C"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Ink (primary text)",
        "default": "#F2F2F2"
      },
      {
        "type": "color",
        "id": "color_text_mute",
        "label": "Muted text",
        "default": "#6E6E6E"
      },
      {
        "type": "header",
        "content": "Accents"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Lime (primary accent)",
        "default": "#BFFF1A"
      },
      {
        "type": "color",
        "id": "color_accent_dim",
        "label": "Lime (AA-safe on light)",
        "default": "#5BBF00"
      },
      {
        "type": "color",
        "id": "color_orange",
        "label": "Orange (urgency / sale)",
        "default": "#FF6B2C"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Display font (headlines)",
        "default": "inter_n9"
      },
      {
        "type": "range",
        "id": "display_letter_spacing",
        "label": "Display letter-spacing (%)",
        "min": -8,
        "max": 0,
        "step": 1,
        "default": -4,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo (used on dark canvas)"
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logo (used on light canvas)"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height (px)",
        "min": 20,
        "max": 60,
        "step": 2,
        "default": 28,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_max_width",
        "label": "Max page width (px)",
        "min": 1200,
        "max": 1600,
        "step": 40,
        "default": 1280,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_padding_y",
        "label": "Section vertical padding (px)",
        "min": 40,
        "max": 200,
        "step": 8,
        "default": 96,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Theme toggle",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_theme_toggle",
        "label": "Show light/dark toggle in nav",
        "default": true
      },
      {
        "type": "select",
        "id": "default_theme",
        "label": "Default theme",
        "options": [
          { "value": "dark", "label": "Dark" },
          { "value": "light", "label": "Light" }
        ],
        "default": "dark"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_reveals",
        "label": "Enable scroll-reveal animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_card_hover",
        "label": "Enable product card hover crossfade",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X / Twitter URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  }
]
